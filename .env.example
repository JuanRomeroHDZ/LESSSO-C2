# ==========================================================
# LESSSO C2 — Plantilla de configuración de entorno
# ----------------------------------------------------------
# Este archivo SÍ se commitea. Es la plantilla pública.
#
# Para empezar:
#   1. Copia este archivo a `.env`:
#        cp .env.example .env
#   2. Edita `.env` con TUS credenciales únicas.
#   3. Nunca commitees `.env` (ya está en .gitignore).
# ==========================================================

# ----------------------------------------------------------
# POSTGRES
# ----------------------------------------------------------
POSTGRES_USER=lessso_admin
POSTGRES_PASSWORD=cambia_esta_password_por_una_segura
POSTGRES_DB=juanmap_db

POSTGRES_HOST_PORT=127.0.0.1:5433

# ----------------------------------------------------------
# REDIS
# ----------------------------------------------------------
REDIS_HOST_PORT=127.0.0.1:6380

# ----------------------------------------------------------
# API (FastAPI)
# ----------------------------------------------------------
API_HOST_PORT=127.0.0.1:8001

# ----------------------------------------------------------
# URLs COMPUESTAS
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------
# NVD (National Vulnerability Database) — OPCIONAL
# ----------------------------------------------------------
# Sin API key: 5 req / 30s.
# Con API key: 50 req / 30s.
# Pide una gratis en: https://nvd.nist.gov/developers/request-an-api-key
#
# Si lo dejas vacío, el backend funciona igual (más lento).
NVD_API_KEY=

# TTL del cache de CVEs en Redis (segundos). 86400 = 24h.
CVE_CACHE_TTL_S=86400

# Si Redis cae, ¿debe fallar el backend? (false = modo best-effort)
CVE_CACHE_REQUIRED=false

# Si NVD falla, ¿devolvemos 200 con lista vacía (true) o 502 (false)?
NVD_SOFT_FAIL=true

# Timeout de NVD por request (segundos)
NVD_TIMEOUT_S=15
