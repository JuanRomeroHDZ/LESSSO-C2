# ==========================================================
# LESSSO C2 — Ejemplo de configuración de entorno
# ----------------------------------------------------------
# Copia este archivo a .env y edita los valores:
#
#   cp .env.example .env
#
# .env NO se commitea (está en .gitignore).
# ==========================================================

# ----------------------------------------------------------
# POSTGRES
# ----------------------------------------------------------
# ⚠ CAMBIA ESTOS VALORES por credenciales únicas de tu entorno
POSTGRES_USER=lessso_admin
POSTGRES_PASSWORD=CambiaEstaPasswordPorUnaSegura2024!
POSTGRES_DB=lessso_c2_db

# Puerto del host donde se expondrá Postgres.
# 127.0.0.1 significa "solo accesible desde esta máquina".
# ⚠ NO uses 0.0.0.0 o lo expondrás a toda la red.
POSTGRES_HOST_PORT=127.0.0.1:5433

# ----------------------------------------------------------
# REDIS
# ----------------------------------------------------------
REDIS_HOST_PORT=127.0.0.1:6380

# ----------------------------------------------------------
# API (FastAPI)
# ----------------------------------------------------------
API_HOST_PORT=127.0.0.1:8001

# ----------------------------------------------------------
# URLs COMPUESTAS
# ----------------------------------------------------------
# Dentro de la red de Docker, los servicios se llaman por su
# nombre (`db`, `redis`), NO por localhost. Y usan los puertos
# internos (5432, 6379), NO los del host.
DATABASE_URL=postgresql+asyncpg://lessso_admin:CambiaEstaPasswordPorUnaSegura2024!@db:5432/lessso_c2_db
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------
# CORS — Orígenes permitidos del frontend
# ----------------------------------------------------------
# En dev Tauri/Vite. Si accedes desde otro host,
# añade el tuyo separado por comas.
FRONTEND_URL=http://localhost:5173,tauri://localhost,http://tauri.localhost

# ----------------------------------------------------------
# NVD (National Vulnerability Database) — API v2
# ----------------------------------------------------------
# Obtén una key gratis en:
#   https://nvd.nist.gov/developers/request-an-api-key
#
# Sin key: 5 req / 30s  →  ~6s por consulta (lento con muchos puertos)
# Con key: 50 req / 30s →  ~0.7s por consulta (recomendado)
#
# Formato: 36 caracteres alfanuméricos, sin espacios ni comillas.
# Ejemplo: NVD_API_KEY=12345678-1234-1234-1234-123456789012
NVD_API_KEY=

# URL base de NVD (no cambiar salvo proxies/mirrors)
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# TTL del cache de CVEs en Redis (segundos). 86400 = 24h.
CVE_CACHE_TTL_S=86400

# Si Redis cae, ¿debe fallar el backend? (false = best-effort)
CVE_CACHE_REQUIRED=false

# Si NVD falla, ¿devolvemos 200 con lista vacía (true) o 502 (false)?
NVD_SOFT_FAIL=true

# Timeout de NVD por request (segundos)
NVD_TIMEOUT_S=15

# Máximo de CVEs a devolver por item
NVD_MAX_RESULTS_PER_ITEM=25
