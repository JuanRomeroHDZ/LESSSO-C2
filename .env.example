# ==========================================================
# LESSSO C2 — Plantilla de configuración de entorno
# ----------------------------------------------------------
# Este archivo SÍ se commitea. Es la plantilla pública.
#
# Para empezar:
#   1. Copia este archivo a `.env`:
#        cp .env.example .env
#   2. Edita `.env` con TUS credenciales únicas.
#   3. Nunca commitees `.env` (ya está en .gitignore).
# ==========================================================

# ----------------------------------------------------------
# POSTGRES
# ----------------------------------------------------------
# ⚠️ Cambia el usuario y la contraseña por valores únicos.
# Los valores mostrados son solo placeholders de ejemplo.
POSTGRES_USER=lessso_admin
POSTGRES_PASSWORD=cambia_esta_password_por_una_segura
POSTGRES_DB=juanmap_db

# Puerto del host donde se expondrá Postgres.
# Mantén el prefijo 127.0.0.1 para que solo sea accesible
# desde tu máquina (NUNCA uses 0.0.0.0 en producción).
POSTGRES_HOST_PORT=127.0.0.1:5433

# ----------------------------------------------------------
# REDIS
# ----------------------------------------------------------
REDIS_HOST_PORT=127.0.0.1:6380

# ----------------------------------------------------------
# API (FastAPI)
# ----------------------------------------------------------
API_HOST_PORT=127.0.0.1:8001

# ----------------------------------------------------------
# URLs COMPUESTAS
# ----------------------------------------------------------
# Estas variables usan las de arriba. Docker Compose las expande
# al levantar los contenedores.
#
# Nota: dentro de la red Docker, los servicios se resuelven por
# su nombre (`db`, `redis`), no por localhost. Y usan los puertos
# internos (5432, 6379), no los del host.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0
