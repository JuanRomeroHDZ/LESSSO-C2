{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LESSSO C2",
  "version": "0.1.0",
  "identifier": "com.juanmap.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LESSSO C2 - Red Team Workspace",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:8001 http://localhost:5173 ws://localhost:5173 ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$TEMP/**",
          "$HOME/.local/share/com.juanmap.desktop/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "nmap",
          "openvpn",
          "pkexec",
          "wl-clipboard"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
